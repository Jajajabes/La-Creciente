---
import { navegacion, sitio } from "../data/sitio";
import Logo from "./Logo.astro";

const actual = Astro.url.pathname;
const esActiva = (url: string) =>
  url === "/" ? actual === "/" : actual.startsWith(url);
---

<header class="cab">
  <div class="contenedor cab__fila">
    <a href="/" class="cab__marca" aria-label={`${sitio.nombre} — Inicio`}>
      <Logo />
    </a>

    <input type="checkbox" id="menu-toggle" class="cab__check" />
    <label for="menu-toggle" class="cab__hamburguesa" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="cab__nav" aria-label="Principal">
      <ul>
        {
          navegacion.map((item) => (
            <li>
              <a
                href={item.url}
                class:list={["cab__link", { activo: esActiva(item.url) }]}
                aria-current={esActiva(item.url) ? "page" : undefined}
              >
                {item.texto}
              </a>
            </li>
          ))
        }
        <li class="cab__cta">
          <a href="/contacto/" class="btn btn--violeta">Súmate</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--papel);
    border-bottom: 3px solid var(--tinta);
  }
  .cab__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 76px;
  }
  .cab__marca {
    text-decoration: none;
    color: var(--tinta);
    display: inline-flex;
    flex-shrink: 0;
  }

  .cab__nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }
  .cab__link {
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--tinta);
    position: relative;
    padding: 0.2em 0;
  }
  .cab__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 3px;
    background: var(--violeta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }
  .cab__link:hover::after,
  .cab__link.activo::after {
    transform: scaleX(1);
  }
  .cab__link.activo {
    color: var(--violeta);
  }

  /* Menú móvil */
  .cab__check,
  .cab__hamburguesa {
    display: none;
  }
  .cab__hamburguesa {
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
    border: 2px solid var(--tinta);
    border-radius: var(--radio);
  }
  .cab__hamburguesa span {
    display: block;
    width: 26px;
    height: 3px;
    background: var(--tinta);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 860px) {
    .cab__hamburguesa {
      display: flex;
    }
    .cab__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--papel);
      border-bottom: 3px solid var(--tinta);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.32s ease;
    }
    .cab__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
    }
    .cab__nav li {
      border-bottom: 1px solid var(--papel-3);
    }
    .cab__link {
      display: block;
      padding: 1rem 0;
      font-size: 1.4rem;
    }
    .cab__cta {
      border-bottom: none !important;
      padding-top: 1rem;
    }
    .cab__cta .btn {
      width: 100%;
      justify-content: center;
    }
    .cab__check:checked ~ .cab__nav {
      max-height: 80vh;
    }
    .cab__check:checked ~ .cab__hamburguesa span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .cab__check:checked ~ .cab__hamburguesa span:nth-child(2) {
      opacity: 0;
    }
    .cab__check:checked ~ .cab__hamburguesa span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>
