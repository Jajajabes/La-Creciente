---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import OlaDivisor from "../components/OlaDivisor.astro";
import Marquesina from "../components/Marquesina.astro";
import { principios } from "../data/sitio";
import qs from "../data/contenido/quienes-somos.json";
---

<Base
  titulo="Quiénes Somos"
  descripcion="Nuestro horizonte, principios y trabajo político: un socialismo renovado que recoge las banderas del marxismo, el feminismo, el antirracismo y el pensamiento descolonial."
>
  <section class="encab">
    <div class="contenedor">
      <p class="kicker encab__kicker">{qs.encab.kicker}</p>
      <h1 class="encab__titulo">{qs.encab.titulo}</h1>
      <p class="encab__bajada">{qs.encab.bajada}</p>
    </div>
  </section>

  <Marquesina items={qs.marquesina} />

  <!-- Horizonte / colectividad -->
  <section class="seccion">
    <div class="contenedor horizonte__grid">
      <div class="horizonte__texto revelar">
        <p class="kicker">{qs.horizonte.kicker}</p>
        <h2>{qs.horizonte.titulo}</h2>
        <p class="horizonte__lead">{qs.horizonte.lead}</p>
        {qs.horizonte.parrafos.map((p) => <p>{p}</p>)}
      </div>
      <ol class="linea-tiempo" aria-label="Hitos de La Creciente">
        {
          qs.hitos.map((h) => (
            <li class="linea-tiempo__item revelar">
              <span class="linea-tiempo__anio">{h.anio}</span>
              <p>{h.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Socialismo renovado -->
  <section class="seccion renovado">
    <div class="contenedor">
      <header class="cab-seccion cab-seccion--claro">
        <div>
          <p class="kicker">{qs.renovado.kicker}</p>
          <h2>{qs.renovado.titulo}</h2>
        </div>
      </header>
      <div class="renovado__grid">
        {
          qs.renovado.debates.map((d, i) => (
            <article class="debate">
              <span class="debate__num">{String(i + 1).padStart(2, "0")}</span>
              <p>{d}</p>
            </article>
          ))
        }
      </div>
      <p class="renovado__cierre">{qs.renovado.cierre}</p>
    </div>
  </section>

  <!-- Principios -->
  <section class="seccion principios">
    <div class="contenedor">
      <header class="cab-seccion">
        <div>
          <p class="kicker">{qs.principios.kicker}</p>
          <h2>{qs.principios.titulo}</h2>
        </div>
      </header>
      <div class="principios__grid">
        {
          principios.map((p) => (
            <article class="principio" style={`--c:${p.color}`}>
              <span class="principio__marca" aria-hidden="true" />
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </article>
          ))
        }
      </div>
      <div class="principios__cta">
        <a href="/quienes-somos/estatutos/" class="btn btn--violeta">{qs.principios.boton} <Icon name="ph:arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- Ejes -->
  <section class="seccion ejes">
    <div class="contenedor">
      <header class="cab-seccion">
        <div>
          <p class="kicker">{qs.ejes.kicker}</p>
          <h2>{qs.ejes.titulo}</h2>
        </div>
      </header>
      <div class="ejes__grid">
        {
          qs.ejes.items.map((e) => (
            <article class="eje">
              <div class="eje__icono"><Icon name={e.icono} /></div>
              <p>{e.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <OlaDivisor fondo="var(--papel)" relleno="var(--violeta)" />

  <!-- Proyección política -->
  <section class="proyeccion">
    <div class="contenedor proyeccion__inner">
      <p class="kicker proyeccion__kicker">{qs.proyeccion.kicker}</p>
      <h2>{qs.proyeccion.titulo}</h2>
      <div class="proyeccion__cols">
        {qs.proyeccion.parrafos.map((p) => <p>{p}</p>)}
      </div>
      <p class="proyeccion__lema">{qs.proyeccion.lema}</p>
      <a href="/contacto/" class="btn btn--amarillo">{qs.proyeccion.boton} <Icon name="ph:arrow-right" /></a>
    </div>
  </section>
</Base>

<style>
  .encab {
    background: var(--violeta);
    color: var(--papel);
    padding-block: clamp(2.5rem, 5vw, 4.25rem);
    border-bottom: 3px solid var(--tinta);
  }
  .encab__kicker {
    color: var(--amarillo);
    margin-bottom: 1.2rem;
  }
  .encab__titulo {
    color: var(--papel);
    margin-bottom: 1.5rem;
  }
  .encab__bajada {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1rem + 1vw, 1.6rem);
    line-height: 1.45;
    max-width: 46ch;
    color: color-mix(in srgb, var(--papel) 90%, transparent);
  }

  /* Cabeceras */
  .cab-seccion {
    margin-bottom: 2.4rem;
  }
  .cab-seccion h2 {
    color: var(--violeta);
    margin-top: 0.3rem;
  }
  .cab-seccion .kicker {
    color: var(--tenue);
  }
  .cab-seccion--claro h2 {
    color: var(--papel);
  }
  .cab-seccion--claro .kicker {
    color: var(--amarillo);
  }

  /* Horizonte */
  .horizonte__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 820px) {
    .horizonte__grid {
      grid-template-columns: 1fr;
    }
  }
  .horizonte__texto h2 {
    color: var(--violeta);
    margin: 0.4rem 0 1.3rem;
  }
  .horizonte__texto p {
    margin-bottom: 1.1rem;
    max-width: 58ch;
    font-size: 1.08rem;
  }
  .horizonte__lead {
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.4rem) !important;
    line-height: 1.45;
    font-family: var(--serif);
    color: var(--violeta);
  }

  .linea-tiempo {
    list-style: none;
    border-left: 3px solid var(--tinta);
    padding-left: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }
  .linea-tiempo__item {
    position: relative;
  }
  .linea-tiempo__item::before {
    content: "";
    position: absolute;
    left: calc(-1.6rem - 1.5px);
    top: 0.15em;
    transform: translateX(-50%);
    width: 16px;
    height: 16px;
    background: var(--amarillo);
    border: 3px solid var(--tinta);
    border-radius: 50%;
  }
  .linea-tiempo__anio {
    font-family: var(--display);
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--violeta);
    display: block;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  /* Socialismo renovado */
  .renovado {
    background: var(--violeta-profundo);
    color: var(--papel);
    border-block: 3px solid var(--tinta);
  }
  .renovado__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1.4rem;
  }
  .debate {
    border: 2px solid color-mix(in srgb, var(--papel) 30%, transparent);
    border-radius: var(--radio);
    padding: 1.4rem 1.5rem;
    background: color-mix(in srgb, var(--papel) 5%, transparent);
  }
  .debate__num {
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--amarillo);
    display: block;
    line-height: 1;
    margin-bottom: 0.6rem;
  }
  .debate p {
    color: color-mix(in srgb, var(--papel) 92%, transparent);
  }
  .renovado__cierre {
    margin-top: 2.2rem;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1rem + 0.9vw, 1.5rem);
    line-height: 1.45;
    max-width: 60ch;
  }

  /* Principios */
  .principios {
    background: var(--papel-2);
    border-bottom: 3px solid var(--tinta);
  }
  .principios__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1.4rem;
  }
  .principio {
    background: var(--papel);
    border: 3px solid var(--tinta);
    border-radius: var(--radio);
    padding: 1.5rem;
    box-shadow: var(--sombra-dura-sm);
  }
  .principio__marca {
    display: block;
    width: 44px;
    height: 10px;
    background: var(--c);
    margin-bottom: 1rem;
  }
  .principio h3 {
    color: var(--violeta);
    margin-bottom: 0.6rem;
    font-size: 1.35rem;
  }
  .principios__cta {
    margin-top: 2.2rem;
  }

  /* Ejes */
  .ejes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.4rem;
  }
  .eje {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: var(--papel);
    border: 3px solid var(--tinta);
    border-top: 10px solid var(--violeta);
    border-radius: var(--radio);
    padding: 1.5rem;
    box-shadow: var(--sombra-dura-sm);
    font-weight: 500;
  }
  .eje__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--violeta);
    color: var(--papel);
    border: 3px solid var(--tinta);
    border-radius: var(--radio);
  }
  .eje__icono svg {
    width: 26px;
    height: 26px;
  }

  /* Proyección */
  .proyeccion {
    background: var(--violeta);
    color: var(--papel);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .proyeccion__kicker {
    color: var(--amarillo);
  }
  .proyeccion h2 {
    color: var(--papel);
    margin: 0.6rem 0 2rem;
  }
  .proyeccion__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .proyeccion__cols p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--papel) 92%, transparent);
  }
  .proyeccion__lema {
    font-family: var(--display);
    text-transform: uppercase;
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.6rem);
    color: var(--amarillo);
    margin-bottom: 1.8rem;
  }
</style>
