---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const piezas = await getCollection("prensa", ({ data }) => !data.borrador);
  return piezas.map((pieza) => ({
    params: { slug: pieza.id },
    props: { pieza },
  }));
}

const { pieza } = Astro.props;
const { Content } = await render(pieza);
const d = pieza.data;

const etiquetas = {
  comunicado: { texto: "Comunicado", color: "var(--rojo)" },
  opinion: { texto: "Opinión", color: "var(--violeta)" },
  formacion: { texto: "Formación", color: "var(--cian)" },
} as const;
const et = etiquetas[d.tipo];
const fechaTxt = d.fecha.toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base titulo={d.titulo} descripcion={d.resumen}>
  <article>
    <header class="art-cab" style={`--c:${et.color}`}>
      <div class="contenedor">
        <a href="/prensa/" class="art-cab__volver">← Prensa &amp; formación</a>
        <span class="art-cab__tipo">{et.texto}</span>
        <h1 class="art-cab__titulo">{d.titulo}</h1>
        <p class="art-cab__meta">
          <span>{d.autor}</span>
          <span aria-hidden="true">·</span>
          <time datetime={d.fecha.toISOString()}>{fechaTxt}</time>
        </p>
      </div>
    </header>

    <div class="contenedor art-cuerpo">
      <p class="art-cuerpo__resumen">{d.resumen}</p>
      <div class="prosa">
        <Content />
      </div>

      <div class="art-cierre">
        <p>¿Te resonó? La marea crece con quienes la difunden y la habitan.</p>
        <div class="art-cierre__btns">
          <a href="/contacto/" class="btn btn--violeta">Súmate →</a>
          <a href="/prensa/" class="btn btn--fantasma">Más publicaciones</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .art-cab {
    background: var(--violeta);
    color: var(--papel);
    padding-block: clamp(2.5rem, 6vw, 5rem);
    border-bottom: 6px solid var(--c);
  }
  .art-cab__volver {
    display: inline-block;
    color: color-mix(in srgb, var(--papel) 80%, transparent);
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 1.6rem;
  }
  .art-cab__volver:hover {
    color: var(--amarillo);
  }
  .art-cab__tipo {
    display: inline-block;
    background: var(--c);
    color: var(--papel);
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25em 0.9em;
    border-radius: 999px;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .art-cab__titulo {
    color: var(--papel);
    font-size: clamp(2rem, 1.3rem + 4vw, 4rem);
    max-width: 22ch;
    margin-bottom: 1.2rem;
  }
  .art-cab__meta {
    display: flex;
    gap: 0.7ch;
    align-items: center;
    font-weight: 600;
    color: color-mix(in srgb, var(--papel) 85%, transparent);
  }

  .art-cuerpo {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .art-cuerpo__resumen {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem);
    line-height: 1.45;
    color: var(--violeta);
    border-left: 6px solid var(--amarillo);
    padding-left: 1.2rem;
    max-width: 60ch;
    margin-bottom: 2.5rem;
  }

  .art-cierre {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 3px solid var(--papel-3);
    max-width: 68ch;
  }
  .art-cierre p {
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 1.4rem;
  }
  .art-cierre__btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
