---
import "../styles/fuentes.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { sitio } from "../data/sitio";

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}

const {
  titulo,
  descripcion = sitio.descripcion,
  imagen = "/og-default.svg",
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} — ${sitio.nombre}` : `${sitio.nombre} · ${sitio.lema}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#340052" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(imagen, Astro.site).href} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/img/buho.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${sitio.nombre} — Prensa`}
      href="/rss.xml"
    />

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- "Anybody" (fuente de marca para texto/UI). Las Art Nouveau se auto-alojan. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      // Aparición progresiva al hacer scroll (respeta prefers-reduced-motion).
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = document.querySelectorAll<HTMLElement>(".revelar");
      if (reduce || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>

    <style>
      .saltar {
        position: absolute;
        left: 0.6rem;
        top: -3rem;
        z-index: 10000;
        background: var(--tinta);
        color: var(--papel);
        padding: 0.6rem 1rem;
        font-family: var(--display);
        text-transform: uppercase;
        text-decoration: none;
        transition: top 0.18s ease;
      }
      .saltar:focus {
        top: 0.6rem;
      }
    </style>
  </body>
</html>
